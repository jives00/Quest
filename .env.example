# Quest — environment variable reference. Copy to .env and fill in real values.

# --- Auth / DB (copy Trakt) ---
JWT_SECRET=change-me-long-random-string   # signs JWT access tokens
ADMIN_USERNAME=admin                        # seeded by ensureAdminUser()
ADMIN_PASSWORD=change-me                     # seeded admin password
DB_HOST=100.115.171.80                       # NAS MySQL over Tailscale (synology)
DB_PORT=3306
DB_NAME=quest                                # database must exist before migrate
DB_USER=questuser                            # user with grants on `quest`
DB_PASSWORD=change-me

# --- Metadata ---
IGDB_CLIENT_ID=                              # Twitch dev app (dev.twitch.tv/console/apps)
IGDB_CLIENT_SECRET=                          # Twitch dev app secret
RAWG_API_KEY=                                # rawg.io/apidocs (match fallback)
STEAMGRIDDB_KEY=                             # optional — nicer cover/hero art
ITAD_API_KEY=                                # optional — IsThereAnyDeal pricing; register at isthereanydeal.com/dev/app/

# --- Sources ---
STEAM_API_KEY=                               # steamcommunity.com/dev/apikey
STEAM_ID64=                                  # your 64-bit Steam ID; profile must be public
PSN_NPSSO=                                   # PSN NPSSO token (ca.account.sony.com/.../npsso); ~2-month lifetime
OPENXBL_API_KEY=                             # Xbox/Game Pass via OpenXBL — get a key at xbl.io
# Epic / GOG / Meta Quest need no keys — they are one-shot library imports (Settings → Imports)

# --- Gaming-PC agents (tools/shortcut-watcher, tools/screenshot-sync) ---
SCROBBLE_API_KEY=                            # X-Api-Key the agents send

# --- Screenshot pipeline ---
# Local dev shares the NAS database, so point these at the same NAS folders the
# container uses (over SMB) -- otherwise the DB lists shots whose files aren't here.
# docker-compose.yml sets the container's own values (/data/...).
SCREENSHOT_STAGING_DIR=\\Synology\docker\quest\screenshots
WALLPAPER_DIR=\\Synology\Wallpapers\Video Games

# --- Ports ---
API_PORT=3007                                # web is 3006
